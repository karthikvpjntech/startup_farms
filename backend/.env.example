# ==============================================================================
# Agri-Smart Ecosystem — Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME=Agri-Smart Ecosystem
APP_ENV=development
DEBUG=true

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL / Local SQLite / Local Postgres)
# ------------------------------------------------------------------------------
# Option A: Supabase Connection Pooler (Recommended for production & serverless, port 6543):
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Option B: Supabase Direct Connection (Session Mode, port 5432):
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# Option C: Local Development SQLite:
DATABASE_URL=sqlite:///./agri_smart.db

# ------------------------------------------------------------------------------
# CORS & Frontend Origins
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Initial Root Super Admin Seed Configuration
# ------------------------------------------------------------------------------
SUPER_ADMIN_NAME=System Administrator
SUPER_ADMIN_MOBILE=9999999999
SUPER_ADMIN_EMAIL=admin@agrismart.local
SUPER_ADMIN_PASSWORD=SuperAdminDevPass123!

# ------------------------------------------------------------------------------
# JWT Authentication Configuration (RS256 Asymmetric Keypair)
# ------------------------------------------------------------------------------
JWT_ALGORITHM=RS256
# Leave blank in development to auto-generate transient keys
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# Cloudinary Media Storage (Photos for Crops, Stages, Livestock & Certificates)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true
CLOUDINARY_FOLDER=agri_smart

# ------------------------------------------------------------------------------
# Email / SMTP Notification Settings
# ------------------------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=notifications@agrismart.local
SMTP_FROM_NAME=Agri-Smart Ecosystem
SMTP_TLS=true
SMTP_SSL=false

# ------------------------------------------------------------------------------
# SMS / Message Notification Settings
# ------------------------------------------------------------------------------
SMS_ENABLED=false
# SMS_PROVIDER options: LOG_CONSOLE, TWILIO, FAST2SMS
SMS_PROVIDER=LOG_CONSOLE

# Twilio Credentials (if SMS_PROVIDER=TWILIO):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Fast2SMS API Key (if SMS_PROVIDER=FAST2SMS):
FAST2SMS_API_KEY=

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Test Mode / Live Mode)
# ------------------------------------------------------------------------------
RAZORPAY_ENABLED=true
# Use Test Key ID & Secret starting with rzp_test_... for test transactions:
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_CURRENCY=INR
